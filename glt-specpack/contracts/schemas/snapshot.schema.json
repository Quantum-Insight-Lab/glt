{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glt.dev/schemas/v1alpha1/snapshot.schema.json",
  "title": "TopologySnapshot",
  "description": "Immutable topology snapshot. Nodes and edges are fully materialized: no defaults are left implicit (PROTO-05). The digest covers the canonical form of this document with the digest member removed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "snapshot_id",
    "as_of",
    "registry_version",
    "boundary_id",
    "source_digests",
    "collector_versions",
    "nodes",
    "edges",
    "digest"
  ],
  "properties": {
    "apiVersion": { "const": "glt.dev/v1alpha1" },
    "kind": { "const": "TopologySnapshot" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date-time" },
    "registry_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "boundary_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*@\\d+$" },
    "pinned_to": {
      "type": "object",
      "additionalProperties": false,
      "description": "PROTO-10: every snapshot is pinned to a git SHA, artifact digest or deployment id.",
      "properties": {
        "git_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "deployment_id": { "type": "string" }
      },
      "minProperties": 1
    },
    "source_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "collector_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
    },
    "config_profile": { "type": "string" },
    "matrix_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "node.schema.json" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "edge.schema.json" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "All-zero value is the reserved unfrozen placeholder and MUST fail the freeze check."
    }
  }
}
