{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glt.dev/schemas/v1alpha1/registry-entry.schema.json",
  "title": "RegistryEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "glt.dev/v1alpha1" },
    "kind": { "const": "RegistryEntry" },
    "metadata": { "$ref": "node.schema.json#/$defs/identity" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["node", "action", "gate", "check", "collector"]
        },
        "description": { "type": "string" },
        "schema_ref": { "type": "string", "format": "uri" },
        "action_spec": { "$ref": "action-spec.schema.json" },
        "deprecated": { "type": "boolean" },
        "replacement_id": { "type": "string" },
        "compatible_with": {
          "type": "array",
          "items": { "type": "string" }
        },
        "node": {
          "$ref": "node.schema.json#/$defs/declaration",
          "description": "Topology declaration materialized into a Node by the snapshot compiler."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["node", "gate", "check", "collector"] }
            }
          },
          "then": {
            "required": ["node"],
            "properties": { "node": true }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "action" } }
          },
          "then": {
            "required": ["action_spec"],
            "properties": { "action_spec": true }
          }
        }
      ]
    }
  }
}
