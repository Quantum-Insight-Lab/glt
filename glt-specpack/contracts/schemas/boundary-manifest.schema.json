{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glt.dev/schemas/v1alpha1/boundary-manifest.schema.json",
  "title": "BoundaryManifest",
  "description": "Coverage boundary: node and edge ids treated as in-scope. Divergence from the registry bundle is a compile error (DEV-06), not a silent skip.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "glt.dev/boundary/v1" },
    "kind": { "const": "BoundaryManifest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "nodes", "edges", "outside_boundary_policy"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
        },
        "edges": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
        },
        "outside_boundary_policy": {
          "type": "string",
          "enum": ["known_unknowns_required"]
        }
      }
    }
  }
}
