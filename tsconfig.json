{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@glt/contracts": ["./control-plane/packages/contracts/src/index.ts"],
      "@glt/contracts/*": ["./control-plane/packages/contracts/src/*"],
      "@glt/domain": ["./control-plane/packages/domain/src/index.ts"],
      "@glt/domain/*": ["./control-plane/packages/domain/src/*"],
      "@glt/registry": ["./control-plane/packages/registry/src/index.ts"],
      "@glt/snapshot": ["./control-plane/packages/snapshot/src/index.ts"],
      "@glt/collectors": ["./control-plane/packages/collectors/src/index.ts"],
      "@glt/impact": ["./control-plane/packages/impact/src/index.ts"],
      "@glt/dashboard": ["./control-plane/packages/dashboard/src/index.ts"],
      "@glt/cli": ["./control-plane/packages/cli/src/index.ts"]
    }
  },
  "include": ["control-plane/**/*.ts", "*.ts"]
}
